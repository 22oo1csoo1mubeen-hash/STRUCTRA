# Supabase project URL (for example: https://your-project.supabase.co)
SUPABASE_URL=

# Supabase publishable API key, used for public Auth API requests
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key, reserved for server-only operations
SUPABASE_SECRET_KEY=

# Gemini API key used only by backend AI services
GEMINI_API_KEY=

# Gemini model used for document extraction (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq API key used for fallback backend AI services
GROQ_API_KEY=

# Groq model used for fallback extraction (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Maximum size of an uploaded document in bytes (default: 10 MiB)
DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760

# Private Supabase Storage bucket for original document uploads
SUPABASE_STORAGE_BUCKET=documents
