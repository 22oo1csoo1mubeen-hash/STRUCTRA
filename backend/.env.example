# Supabase project URL (for example: https://your-project.supabase.co)
SUPABASE_URL=

# Supabase publishable API key, used for public Auth API requests
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key, reserved for server-only operations
SUPABASE_SECRET_KEY=

# Maximum size of an uploaded document in bytes (default: 10 MiB)
DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760

# Private Supabase Storage bucket for original document uploads
SUPABASE_STORAGE_BUCKET=documents
